      "settings": {
        "main": true,
        "title": "ZenCortex™ Review: Ingredients, Benefits & Hearing Support",
        "meta_descr": "Discover ZenCortex™, a hearing wellness supplement featuring botanical extracts and amino acids. Explore its ingredients, potential benefits, how it works, and safety information to make an informed decision about your daily wellness routine.",
        "header_custom": "",
        "footer_custom": "",
        "html_before": ""
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "& when not (@sticky)": {
              ".navbar-dropdown": {
                "position": "relative !important"
              },
              "& when (@transparent)": {
